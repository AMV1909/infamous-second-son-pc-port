--- /dev/null
+++ b/src/video_core/buffer_cache/upload_parts.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+
+namespace VideoCore {
+template <class Ranges, class Begin, class Copy, class End>
+void ForEachUploadPart(const Ranges& ranges, uint64_t limit, Begin begin, Copy copy, End end) {
+    assert(limit != 0);
+    uint64_t used = 0;
+    for (const auto& range : ranges) {
+        for (uint64_t done = 0; done < range.size;) {
+            if (used == 0) begin();
+            const uint64_t count = std::min<uint64_t>(range.size - done, limit - used);
+            copy(range.dstOffset + done, used, count);
+            used += count;
+            done += count;
+            if (used == limit) { end(used); used = 0; }
+        }
+    }
+    if (used != 0) end(used);
+}
+}
diff --git a/src/video_core/buffer_cache/version_snapshot.h b/src/video_core/buffer_cache/version_snapshot.h
new file mode 100644
index 0000000..430bf37
--- /dev/null
+++ b/src/video_core/buffer_cache/version_snapshot.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+
+namespace VideoCore {
+template <class Read>
+bool CheckVersionSnapshot(std::vector<uint64_t>& snapshot, size_t count, bool compare, Read read) {
+    if (compare && snapshot.size() != count) return false;
+    if (!compare) snapshot.resize(count);
+    for (size_t i = 0; i < count; ++i) {
+        const auto version = read(i);
+        if (!version) return false;
+        if (compare) {
+            if (snapshot[i] != *version) return false;
+        } else {
+            snapshot[i] = *version;
+        }
+    }
+    return count != 0;
+}
+}
