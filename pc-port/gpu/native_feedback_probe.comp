#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Feedback { uint words[]; } feedback;
void main() {
    // Read CPU-authored data and update the +4 counter of a 48-byte GPU record.
    atomicAdd(feedback.words[129], feedback.words[32]);
}
